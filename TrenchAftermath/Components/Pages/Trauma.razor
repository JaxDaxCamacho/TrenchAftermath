@page "/trauma"
@inject WarbandStore Store

<PageTitle>Trauma Roller</PageTitle>

<h1>Trauma Roller</h1>
<p class="text-muted">
    For each model that was taken Out of Action, resolve:
    <strong>Troops</strong> &mdash; D6 Survival Roll, 1-2 dead / 3+ survives.
    <strong>Elites</strong> &mdash; D66 on the Trauma Table.
</p>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_warband is null)
{
    @if (_saved.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Roll for a saved warband</h5>
                <p class="text-muted small mb-3">Pick a warband to see its models, then tick the ones taken Out of Action.</p>
                <div class="list-group">
                    @foreach (var s in _saved)
                    {
                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                @onclick="() => LoadSaved(s.Id)">
                            <span><strong>@s.Name</strong> <small class="text-muted ms-2">@s.Id</small></span>
                            <small class="text-muted">saved @s.SavedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Quick roll (no warband)</h5>
            <p class="text-muted small mb-3">Roll for a single model by typing its name. Useful for one-offs without an imported warband.</p>

            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="unit-name">Unit name</label>
                    <input id="unit-name" class="form-control" placeholder="e.g. Brother Joachim"
                           @bind="_quickName" @bind:event="oninput" @onkeydown="OnQuickKeyDown" />
                </div>
                <div class="col-md-2">
                    <div class="form-check">
                        <input id="is-elite" class="form-check-input" type="checkbox" @bind="_quickIsElite" />
                        <label class="form-check-label" for="is-elite">Elite?</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="manual-roll">
                        @(_quickIsElite ? "Manual D66 (optional)" : "Manual D6 (optional)")
                    </label>
                    <input id="manual-roll" class="form-control" type="number"
                           min="@(_quickIsElite ? 11 : 1)" max="@(_quickIsElite ? 66 : 6)"
                           placeholder="auto" @bind="_quickManualRoll" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" @onclick="ResolveQuick"
                            disabled="@string.IsNullOrWhiteSpace(_quickName)">
                        Roll
                    </button>
                </div>
            </div>

            @if (_quickError is not null)
            {
                <div class="alert alert-warning mt-3 mb-0">@_quickError</div>
            }
        </div>
    </div>

    @if (_quickLog.Count > 0)
    {
        <h2>Session log</h2>
        <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="() => _quickLog.Clear()">Clear log</button>

        <div class="list-group">
            @foreach (var entry in _quickLog.AsEnumerable().Reverse())
            {
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">
                            @entry.UnitName
                            <span class="badge bg-secondary">@(entry.IsElite ? "Elite" : "Troop")</span>
                            <span class="badge bg-dark">@(entry.IsElite ? "D66" : "D6"): @entry.Roll</span>
                        </h5>
                        <small class="text-muted">@entry.Timestamp.ToShortTimeString()</small>
                    </div>
                    <p class="mb-1"><strong>@entry.ResultTitle</strong></p>
                    <p class="mb-0 small">@entry.ResultDescription</p>
                </div>
            }
        </div>
    }
}
else
{
    <div class="card mb-3">
        <div class="card-body py-2 d-flex justify-content-between align-items-center">
            <div>
                <strong>@_warband.WarbandName</strong>
                <span class="text-muted ms-2">@_warband.Models.Count models</span>
            </div>
            <div>
                <button class="btn btn-sm btn-outline-primary me-2" @onclick="RollSelected"
                        disabled="@(_selected.Count == 0)">
                    Roll trauma for selected (@_selected.Count)
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearWarband">Back to warband list</button>
            </div>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var m in _warband.Models)
        {
            var selected = _selected.Contains(m.Index);
            var result = _results.GetValueOrDefault(m.Index);
            <div class="col-md-6">
                <div class="card h-100 @(result is null ? "" : (result.Survived ? "border-success" : "border-danger"))">
                    <div class="card-body">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="@($"sel-{m.Index}")"
                                   checked="@selected" @onchange="(e) => ToggleSelect(m.Index, e.Value is bool b && b)" />
                            <label class="form-check-label" for="@($"sel-{m.Index}")">
                                <strong>@m.Name</strong>
                                @if (m.IsElite)
                                {
                                    <span class="badge bg-info ms-1">Elite</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary ms-1">Troop</span>
                                }
                            </label>
                        </div>

                        <div class="small text-muted mb-2">
                            @m.ModelId &middot;
                            Move @m.StatMove &middot;
                            Melee @m.StatMelee &middot;
                            Ranged @m.StatRanged &middot;
                            Armour @m.StatArmour
                        </div>

                        @if (result is not null)
                        {
                            <div class="mt-2">
                                <span class="badge bg-dark me-1">@(m.IsElite ? "D66" : "D6"): @result.Roll</span>
                                <strong>@result.Title</strong>
                                <p class="mb-1 small">@result.Description</p>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Reroll(m)">Re-roll</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private WarbandSession? _warband;
    private List<SavedWarbandRef> _saved = new();
    private readonly HashSet<int> _selected = new();
    private readonly Dictionary<int, TraumaResult> _results = new();
    private string? _error;

    // Quick-mode state
    private string _quickName = "";
    private bool _quickIsElite = true;
    private int? _quickManualRoll;
    private string? _quickError;
    private readonly List<LogEntry> _quickLog = new();

    protected override async Task OnInitializedAsync()
    {
        _saved = await Store.ListAsync();
    }

    private async Task LoadSaved(string id)
    {
        _error = null;
        var session = await Store.LoadAsync(id);
        if (session is null)
        {
            _error = "Couldn't load that warband — it may have been deleted.";
            _saved = await Store.ListAsync();
            return;
        }
        _warband = session;
        _selected.Clear();
        _results.Clear();
    }

    private void ClearWarband()
    {
        _warband = null;
        _selected.Clear();
        _results.Clear();
    }

    private void ToggleSelect(int idx, bool value)
    {
        if (value) _selected.Add(idx);
        else _selected.Remove(idx);
    }

    private void RollSelected()
    {
        if (_warband is null) return;
        foreach (var idx in _selected.ToList())
        {
            var m = _warband.Models.First(x => x.Index == idx);
            _results[idx] = RollFor(m);
        }
        _selected.Clear();
    }

    private void Reroll(ModelEntry m)
    {
        _results[m.Index] = RollFor(m);
    }

    private static TraumaResult RollFor(ModelEntry m)
    {
        if (m.IsElite)
        {
            var r = Dice.D66();
            var entry = TraumaTable.Lookup(r);
            return new TraumaResult(r, entry.Title, entry.Description, Survived: entry.Title is not "Dead");
        }
        else
        {
            var r = Dice.D6();
            var survived = r >= 3;
            return new TraumaResult(
                r,
                survived ? "Survived" : "Dead",
                survived
                    ? "The Troop survived the battle and can fight on as normal."
                    : "The Troop is dead or very badly wounded. Remove the model from your Warband Roster.",
                Survived: survived);
        }
    }

    private void OnQuickKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_quickName))
        {
            ResolveQuick();
        }
    }

    private void ResolveQuick()
    {
        _quickError = null;
        if (string.IsNullOrWhiteSpace(_quickName))
        {
            _quickError = "Unit name is required.";
            return;
        }

        LogEntry entry;
        if (!_quickIsElite)
        {
            int d6;
            if (_quickManualRoll is int mt)
            {
                if (mt is < 1 or > 6) { _quickError = "Manual D6 must be 1-6."; return; }
                d6 = mt;
            }
            else d6 = Dice.D6();

            var survived = d6 >= 3;
            entry = new LogEntry(
                _quickName.Trim(), IsElite: false, Roll: d6,
                ResultTitle: survived ? "Survived" : "Dead",
                ResultDescription: survived
                    ? $"D6 = {d6}. The Troop survived the battle and can fight on as normal."
                    : $"D6 = {d6}. The Troop is dead or very badly wounded. Remove the model from your Warband Roster.",
                Timestamp: DateTime.Now);
        }
        else
        {
            int roll;
            if (_quickManualRoll is int m)
            {
                if (m is < 11 or > 66 || m % 10 == 0 || m / 10 < 1 || m / 10 > 6 || m % 10 > 6)
                {
                    _quickError = "Manual D66 must be a valid two-digit reading: tens 1-6 and ones 1-6 (e.g. 11, 36, 66).";
                    return;
                }
                roll = m;
            }
            else roll = Dice.D66();

            var traumaResult = TraumaTable.Lookup(roll);
            entry = new LogEntry(
                _quickName.Trim(), IsElite: true, Roll: roll,
                ResultTitle: traumaResult.Title,
                ResultDescription: traumaResult.Description,
                Timestamp: DateTime.Now);
        }

        _quickLog.Add(entry);
        _quickName = "";
        _quickManualRoll = null;
    }

    private sealed record TraumaResult(int Roll, string Title, string Description, bool Survived);

    private sealed record LogEntry(
        string UnitName,
        bool IsElite,
        int Roll,
        string ResultTitle,
        string ResultDescription,
        DateTime Timestamp);
}
