@page "/"

<PageTitle>Trench Aftermath</PageTitle>

<h1>Trench Aftermath</h1>

<p class="lead">Resolve the Campaign Phase after a Trench Crusade battle.</p>

<div class="row mt-4 g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Trauma Roller</h5>
                <p class="card-text">
                    Standalone D66 roller for the Trauma Step. Enter a unit name, tick Elite,
                    roll (or enter a physical roll), and look up the result on the Trauma Table.
                </p>
                <a href="trauma" class="btn btn-primary">Open Trauma Roller</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Promotions</h5>
                <p class="card-text">
                    Import a Warband JSON, generate the Promotion Dice Pool from Glorious Deeds,
                    assign dice to Troops, then slow-roll one die at a time. Tracks the
                    pity-timer across games.
                </p>
                <a href="promotions" class="btn btn-primary">Open Promotions</a>
            </div>
        </div>
    </div>
</div>
