@page "/"
@inject WarbandStore Store
@inject SessionState Session
@implements IDisposable

<PageTitle>Trench Aftermath</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Trench Aftermath</h1>
    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#howToModal">
        How To Add a Warband
    </button>
</div>

<p class="lead">Resolve the Campaign Phase after a Trench Crusade battle.</p>

<!-- How To Modal -->
<div class="modal fade" id="howToModal" tabindex="-1" aria-labelledby="howToModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="howToModalLabel">How To Add a Warband</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <h6>Step 1. Create a warband on <a href="https://trench-companion.com" target="_blank">trench-companion.com</a></h6>
                    <p class="text-muted small">Then click on the following button.</p>
                    <img src="images/step1.png" class="img-fluid rounded border" alt="Step 1: Create warband" />
                </div>

                <div class="mb-4">
                    <h6>Step 2. Make sure you have all the warband members updated after the last battle</h6>
                    <p class="text-muted small">Click to Export.</p>
                    <img src="images/step2.png" class="img-fluid rounded border" alt="Step 2: Export warband" />
                </div>

                <div class="mb-2">
                    <h6>Step 3. Choose the TTS JSON option and then click on copy</h6>
                    <p class="text-muted small">Then paste on the JSON input field.</p>
                    <img src="images/step3.png" class="img-fluid rounded border" alt="Step 3: Copy TTS JSON" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<!-- Warband import / current warband display -->
@if (Session.CurrentWarband is null)
{
    @if (_saved.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Saved warbands</h5>
                <p class="text-muted small mb-3">Select a previously imported warband to continue.</p>
                <div class="list-group">
                    @foreach (var s in _saved)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@s.Name</strong>
                                <small class="text-muted ms-2">saved @s.SavedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-primary me-1" @onclick='() => LoadSaved(s.Id)'>Load</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSaved(s.Id)">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Import a new warband</h5>
            <p class="text-muted small mb-3">
                Export your warband from <a href="https://trench-companion.com" target="_blank">trench-companion.com</a>
                and import the JSON file here.
            </p>

            <label class="form-label">Upload warband JSON</label>
            <InputFile class="form-control mb-3" OnChange="OnFileSelected" accept=".json,application/json" />

            <label class="form-label">…or paste JSON</label>
            <textarea class="form-control font-monospace" rows="6"
                      placeholder='{ "warband-name": "...", "models": [ ... ] }'
                      @bind="_pastedJson"></textarea>
            <button class="btn btn-primary mt-2" @onclick="ImportPasted"
                    disabled="@string.IsNullOrWhiteSpace(_pastedJson)">
                Import pasted JSON
            </button>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="card-title mb-1">@Session.CurrentWarband.WarbandName</h5>
                    <p class="text-muted mb-0">
                        @Session.CurrentWarband.Models.Count models
                        &middot; @Session.CurrentWarband.Models.Count(m => !m.IsElite) Troops / @Session.CurrentWarband.Models.Count(m => m.IsElite) Elites
                        &middot; Pity counter: @Session.CurrentWarband.ConsecutiveFailedPromotionDice/5
                    </p>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearWarband">Unload warband</button>
            </div>
        </div>
    </div>

    <div class="row mt-4 g-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Trauma Roller</h5>
                    <p class="card-text">
                        Standalone D66 roller for the Trauma Step. Enter a unit name, tick Elite,
                        roll (or enter a physical roll), and look up the result on the Trauma Table.
                    </p>
                    <a href="trauma" class="btn btn-primary">Open Trauma Roller</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Promotions</h5>
                    <p class="card-text">
                        Generate the Promotion Dice Pool from Glorious Deeds,
                        assign dice to Troops, then slow-roll one die at a time. Tracks the
                        pity-timer across games.
                    </p>
                    <a href="promotions" class="btn btn-primary">Open Promotions</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string? _pastedJson;
    private string? _error;
    private List<SavedWarbandRef> _saved = new();

    protected override async Task OnInitializedAsync()
    {
        _saved = await Store.ListAsync();
        Session.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            await using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();
            await TryParseAndLoad(text);
        }
        catch (Exception ex)
        {
            _error = $"Couldn't read file: {ex.Message}";
        }
    }

    private async Task ImportPasted()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_pastedJson)) return;
        await TryParseAndLoad(_pastedJson);
    }

    private async Task TryParseAndLoad(string json)
    {
        try
        {
            var session = WarbandSession.Parse(json);
            await Store.SaveAsync(session);
            Session.SetWarband(session);
            _saved = await Store.ListAsync();
            _pastedJson = null;
        }
        catch (Exception ex)
        {
            _error = $"Couldn't parse warband JSON: {ex.Message}";
        }
    }

    private async Task LoadSaved(string id)
    {
        _error = null;
        var session = await Store.LoadAsync(id);
        if (session is null)
        {
            _error = "Couldn't load that warband — it may have been deleted.";
            _saved = await Store.ListAsync();
            return;
        }
        Session.SetWarband(session);
    }

    private async Task DeleteSaved(string id)
    {
        await Store.DeleteAsync(id);
        _saved = await Store.ListAsync();
    }

    private void ClearWarband()
    {
        Session.ClearWarband();
    }
}